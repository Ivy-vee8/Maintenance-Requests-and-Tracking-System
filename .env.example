# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# INITIAL_ADMIN_EMAIL: Verified email address permitted to bootstrap the first Administrator account.
INITIAL_ADMIN_EMAIL="okumuvelmaatieno@gmail.com"

# ADMIN_BOOTSTRAP_SECRET: Optional secondary passphrase required when initializing the first admin via API.
ADMIN_BOOTSTRAP_SECRET=""
